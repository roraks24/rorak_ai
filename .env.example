# ==============================================================================
# Rorak AI — Environment Configuration Template
# Copy this file to '.env' in the project root and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider (Groq Cloud API)
# Get an API key from https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 2. Embedding & Cross-Encoder Reranker Models
# Pre-trained HuggingFace sentence transformer models for semantic search
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ------------------------------------------------------------------------------
# 3. RAG Pipeline Tuning Parameters
# ------------------------------------------------------------------------------
# Chunk size (in characters) for RecursiveCharacterTextSplitter
CHUNK_SIZE=500

# Overlap size between adjacent chunks
CHUNK_OVERLAP=50

# Initial similarity search candidate pool size (k chunks retrieved from FAISS)
RETRIEVAL_K=10

# Final top-k reranked chunks passed into LLM prompt context
RERANK_TOP_K=3

# ------------------------------------------------------------------------------
# 4. Storage, Security & Upload Limits
# ------------------------------------------------------------------------------
# Maximum upload payload size in bytes (10485760 bytes = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 5. Database Configuration (PostgreSQL + SQLAlchemy)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://rorak:your_password_here@localhost:5432/rorak

